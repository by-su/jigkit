#!/usr/bin/env python3
"""PreToolUse 훅 — 커밋 직전에 문서 영향을 에이전트 컨텍스트로 **강제 주입**한다.

왜 CLAUDE.md 가 아니라 훅인가: CLAUDE.md 는 P07 이 advisory 라고 못박은 층이고,
이번에 문서를 놓친 것이 정확히 그 층의 실패였다. "에이전트가 기억해서 명령을 돌린다"
로 "에이전트가 잊는 문제" 를 풀 수는 없다.

[M] Bash 로도 PreToolUse 가 발화하고 `tool_input.command` 에 명령이 오며,
`exit 2` 의 stderr 가 모델에게 원문 그대로 전달된다 (probe/results/commit-gate.md).

**막는 조건은 둘이고, 성격이 다르다.**

  A. 새 CLI 표면 — staged diff 가 새 명령·플래그를 추가했는데 그 이름이 어떤
     primary 문서에도 없다. 결정 가능한 존재 판정이라 **staged 문서 유무와
     무관하게** 막는다. 기존 검사(B)는 "처음 생기는" 표면을 언급하는 문서가
     없어 조용히 통과시켰다 — 그 구멍을 이쪽이 닫는다.
  B. 문서 미확인 — (1) staged diff 가 코드를 건드렸고 (2) 그 개념을 언급하는
     primary 문서가 있는데 (3) staged 에 `.md` 가 하나도 없다.

`git commit -a`·pathspec 커밋은 훅 시점의 index 가 비어 있어도 커밋 시점에
작업트리를 stage 한다 — 그 형태는 두 조건 모두 **추적 중인 작업트리**를 기준으로
판정한다. index 만 보면 `-am` 한 방에 게이트 전체가 조용히 우회된다.

B 는 "문서가 맞는가" 를 판정하지 않는다. **"문서를 아예 안 봤다"** 만 본다.
엉뚱한 문서 한 줄만 staged 해도 통과한다 — 그 약점을 알고 쓴다. 단 CHANGELOG.md
는 여기서 문서로 치지 않는다(이력은 현재 상태의 서술이 아니다).

어떤 오류에서도 통과시킨다(exit 0). 이건 보안 장치가 아니라 알림 장치다.
"""
from __future__ import annotations

import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

BYPASS = "JIG_TOUCHED_BYPASS"

# **비대칭이 이 파일의 설계를 정한다.** 오탐은 문서 목록을 한 번 더 보는 비용이지만,
# 누락은 게이트가 아예 없는 것과 같고 아무도 눈치채지 못한다. 그래서 트리거는 넉넉히,
# 우회는 빡빡하게 잡는다 — 둘 다 "게이트가 조용히 꺼지는" 쪽을 피하는 방향이다.

# 값을 **다음 토큰으로** 받는 git 전역 옵션. `git --git-dir .git commit` 처럼
# 옵션 인자가 분리되면 정규식만으로는 서브커맨드를 잘못 짚는다.
_GLOBAL_WITH_VALUE = {"-c", "-C", "--git-dir", "--work-tree", "--namespace",
                      "--exec-path", "--config-env"}

# **토큰화가 실패했을 때만** 쓰는 대비책 (따옴표가 진짜로 깨진 경우 등).
# 정상 경로는 `_segments()` 의 shlex 토큰화다 — 트리거와 우회가 서로 다른 모델을
# 보면 가장자리에서 갈라진다.
_GIT_COMMIT_RE = re.compile(
    r"(?:^|[;&|(]|\s)git(?:\s+(?:-[cC]\s*\S+|--\S+))*\s+commit(?![\w-])")

# `NAME=value` 형태의 env 대입 토큰.
_ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")

# **index 만 커밋하는 것이 확실한** 옵션들. 여기 없는 long 옵션은 작업트리를 넓히는
# 쪽으로 판정한다 — 모르는 형태를 index 로 좁혀 읽으면 게이트가 조용히 꺼진다.
# 토큰화 실패 분기와 같은 방향의 fail-closed 다: 오판의 비용이 비대칭이다.
_INDEX_SAFE = {"--amend", "--no-edit", "--edit", "--no-verify", "--verify",
               "--verbose", "--quiet", "--dry-run", "--allow-empty",
               "--allow-empty-message", "--signoff", "--no-signoff",
               "--gpg-sign", "--no-gpg-sign", "--reset-author", "--branch",
               "--long", "--short", "--porcelain", "--null", "--status",
               "--no-status", "--no-post-rewrite", "--only", "--untracked-files"}
# 값을 받지만 index 커밋인 옵션 — `=` 없이 오면 다음 토큰이 값이다.
# --untracked-files 는 여기 못 온다: git 은 그 값을 `=` 붙임꼴로만 받으므로,
# 뒤따르는 토큰을 값으로 삼키면 pathspec 커밋이 index 모드로 오판된다.
_INDEX_SAFE_VALUE = {"--message", "--file", "--author", "--date", "--fixup",
                     "--squash", "--reuse-message", "--reedit-message",
                     "--trailer", "--template", "--cleanup"}
# 작업트리를 커밋하는 것이 확실한 long 옵션.
_WIDENING = {"--all", "--include", "--interactive", "--patch",
             "--pathspec-from-file"}


def _cluster_scan(cluster: str) -> tuple[bool, bool]:
    """짧은 옵션 뭉침(`-am`, `-m"fix: x"` 의 `mfix: x` 등) -> (넓히는가, 다음 토큰이 값인가).

    값 옵션 글자(m·F·C·c·t)를 만나면 **뭉침의 나머지는 값이다** — 끝 글자만 보면
    `-m"fix: i"` 의 메시지 본문이 옵션으로 읽혀 판정이 메시지 내용에 좌우된다.
    `-am` 처럼 넓히는 글자와 값 글자가 함께 와도 값 소비를 놓치면 안 된다 —
    놓치면 메시지가 pathspec 으로 읽힌다.
    """
    widens = False
    for idx, ch in enumerate(cluster):
        if ch in "aip":
            widens = True
        elif ch in "mFCct":
            return widens, idx == len(cluster) - 1  # 붙은 값이면 소비 끝, 아니면 다음 토큰
        elif ch == "S":
            return widens, False                    # -S[keyid] — 나머지는 붙은 값
        elif ch not in "svqnezuo":
            return True, False                      # 모르는 글자 — fail-closed
    return widens, False


def _commit_widens(toks: list[str], j: int) -> tuple[bool, list[str]]:
    """`commit` 토큰(toks[j]) 뒤를 보고 (**index 밖을 커밋하는가**, pathspec 목록).

    `git commit -a`·`--all`·`--include`·pathspec 은 커밋 시점에 작업트리를 stage
    한다 — 훅이 도는 시점의 index 는 비어 있을 수 있으므로, 이 형태를 index 기준으로
    판정하면 게이트가 통째로 조용히 우회된다. pathspec 은 판정 범위를 그 경로로
    좁히기 위해 함께 돌려준다 (`-a` 는 빈 목록 = 추적 작업트리 전체).
    """
    widens, paths = False, []
    k = j + 1
    while k < len(toks):
        t = toks[k]
        if t == "--":
            paths += toks[k + 1:]
            return (widens or bool(paths)), paths
        if t.startswith("--"):
            base = t.split("=", 1)[0]
            if base in _WIDENING:
                # --pathspec-from-file 은 경로 목록을 파일로 받는다 — 내용을 읽지
                # 않고 전체 작업트리로 넓힌다 (좁히려다 틀리면 게이트가 꺼진다).
                # --include 의 경로는 옵션 값이 아니라 pathspec 으로 뒤따른다.
                widens = True
                if base == "--pathspec-from-file" and "=" not in t:
                    k += 2
                    continue
            elif base in _INDEX_SAFE_VALUE:
                k += 2 if "=" not in t else 1
                continue
            elif base not in _INDEX_SAFE:
                widens = True                      # 모르는 long 옵션 — fail-closed
        elif t.startswith("-") and len(t) > 1:
            w, eats = _cluster_scan(t[1:])
            widens = widens or w
            if eats:
                k += 2
                continue
        else:
            paths.append(t)                        # 옵션 값이 아닌 맨 토큰 = pathspec
        k += 1
    return (widens or bool(paths)), paths


_OPERATOR_CHARS = ";&|()"


def _segments(command: str) -> list[list[str]]:
    """따옴표를 존중하며 shell operator 로 나눈 토큰 목록.

    먼저 `;`·`&&` 로 자르고 조각마다 `shlex.split` 을 돌리면 **따옴표 안의 operator 도
    잘린다.** `git commit -m "docs: A && B"` 가 그렇게 깨져서 따옴표 불균형이 되고,
    파싱 실패 경로로 빠져 **명시적 우회가 거절**됐다. 안전한 방향이긴 하나
    탈출구가 안 먹히는 건 그것대로 문제다.

    그래서 자르기 전에 토큰화한다 — `punctuation_chars` 로 operator 를 토큰으로 얻고,
    그 경계에서 나눈다.
    """
    lex = shlex.shlex(command, posix=True, punctuation_chars=_OPERATOR_CHARS)
    lex.whitespace_split = True
    lex.commenters = ""  # 커밋 메시지의 `#` 를 주석 시작으로 보면 안 된다

    segments: list[list[str]] = []
    current: list[str] = []
    for tok in lex:
        if tok and set(tok) <= set(_OPERATOR_CHARS):
            if current:
                segments.append(current)
            current = []
        else:
            current.append(tok)
    if current:
        segments.append(current)
    return segments


def _scan(command: str) -> tuple[bool, bool, bool, list[str] | None]:
    """(commit 호출 존재, 전부 우회인가, 작업트리 커밋인가, pathspec — None 은 전체).

    한 번의 토큰화로 둘 다 정한다. 트리거는 shlex 로 보고 우회는 정규식 위치로 보면
    두 모델이 갈라져 구멍이 난다 — 예컨대 `git --git-dir .git commit && BYPASS=1 echo hi`
    에서 정규식은 commit 을 못 찾고, 그러면 뒤에 붙은 대입이 우회로 인정돼 버린다.

    shell 의미론상 `VAR=1 cmd` 는 **그 단순 명령에만** 적용된다. 그래서 우회는
    "같은 세그먼트에서 `git` 토큰 바로 앞의 대입 접두사" 일 때만 인정한다.
    `BYPASS=1 echo hi; git commit` 은 우회가 아니다.
    """
    try:
        segments = _segments(command)
    except ValueError:
        # 토큰화 실패(따옴표 불균형 등). 트리거는 넓게, 우회는 불인정, 판정 범위는
        # 작업트리 전체까지 — 전부 **게이트가 켜진 채로 남는** 방향이다.
        return (bool(_GIT_COMMIT_RE.search(command)), False, True, None)

    calls: list[bool] = []  # git commit 호출별로 "우회됐는가"
    widens = False          # 하나라도 index 밖(작업트리·pathspec)을 커밋하는가
    paths: list[str] | None = []  # 판정 범위. None = 전체 작업트리

    for toks in segments:
        # `git` 토큰이 실행 위치인지까지는 엄밀히 보지 않는다. `echo git commit` 처럼
        # 인자로 등장해도 호출 후보가 된다 — **의도적으로 허용한 오탐**이다.
        # 실제 commit 이 없으면 막아도 무해하고, 있으면 all(calls) 가 지켜 준다.
        for i, t in enumerate(toks):
            if t != "git" and not t.endswith("/git"):
                continue
            j = i + 1
            while j < len(toks) and toks[j].startswith("-"):
                j += 2 if (toks[j] in _GLOBAL_WITH_VALUE and "=" not in toks[j]) else 1
            if j >= len(toks) or toks[j] != "commit":
                continue

            # `git` 바로 앞에 붙은 대입 접두사만 본다.
            bypassed, k = False, i - 1
            while k >= 0 and _ASSIGN.match(toks[k]):
                if toks[k].startswith(BYPASS + "="):
                    bypassed = True
                k -= 1
            calls.append(bypassed)

            # 우회된 호출의 형태는 판정 범위에 전염시키지 않는다 — 우회한 `-am` 이
            # 뒤따르는 index 커밋을 작업트리 기준으로 오판하게 만들면 안 된다.
            if bypassed:
                continue
            w, p = _commit_widens(toks, j)
            if w:
                widens = True
                if p and paths is not None:
                    paths += p
                else:
                    paths = None  # pathspec 없는 넓힘(-a 등)은 전체 작업트리

    return (bool(calls), bool(calls) and all(calls), widens,
            (paths if widens else None) or None)


def is_git_commit(command: str) -> bool:
    """`git` 실행 + `commit` 서브커맨드인가. 놓치면 장치가 없는 것과 같으므로 넓게."""
    return _scan(command)[0]


def is_bypassed(command: str) -> bool:
    """모든 `git commit` 호출이 우회 선언을 달고 있는가.

    우회를 환경변수로 둔 이유 — 트랜스크립트에 흔적이 남는다. 하나라도 우회 없이
    커밋하려 하면 게이트는 켜진다. 느슨하면 조용히 꺼지므로 빡빡하게 잡는다.
    """
    return _scan(command)[1]


def widens_worktree(command: str) -> bool:
    """`-a`·`--all`·pathspec 처럼 커밋 시점에 작업트리를 stage 하는 형태인가."""
    return _scan(command)[2]


def commit_pathspec(command: str) -> list[str] | None:
    """작업트리 커밋의 판정 범위. None 은 전체 작업트리(`-a` 등·비확장 커밋)."""
    return _scan(command)[3]


def _resolve_pathspec(paths: list[str], cwd: str, root: str) -> list[str] | None:
    """cwd 기준 pathspec -> 저장소 루트 기준. 확신이 없으면 None(전체 작업트리).

    touched 는 루트에서 diff 를 돌리므로 하위 디렉터리에서 온 pathspec 을 그대로
    넘기면 아무것도 안 맞아 **게이트가 조용히 꺼진다.** 매직 pathspec(`:` 접두)이나
    루트 밖으로 나가는 경로는 해석하지 않고 전체로 넓힌다 — fail-closed.
    """
    out = []
    for p in paths:
        if p.startswith(":"):
            return None
        q = os.path.relpath(os.path.join(cwd, p), root)
        if q == ".." or q.startswith(".." + os.sep):
            return None
        out.append(q)
    return out


def repo_root(cwd: str) -> Path | None:
    """cwd 가 **jigkit 체크아웃**인지 본다.

    스크립트 자기 위치로 하네스를 유도하지 않는다 — 이 파일은 빌드된 플러그인 안으로
    복사되므로 깊이가 달라진다. 대신 cwd 의 git 루트가 jigkit 표식을 갖는지 확인한다.
    체크아웃이 둘이어도 각자 자기 자신을 게이트한다.
    """
    proc = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        return None
    root = Path(proc.stdout.strip())
    # 표식이 옮겨지면 게이트는 **조용히 꺼진다** — 저장소를 못 알아보고 통과시킨다.
    # tests/test_gate.py 가 실제 체크아웃에서 이 함수가 루트를 찾는지 고정한다.
    marks = (root / "adapters" / "touched.py", root / "bin" / "jig",
             root / "docs" / "PRINCIPLES.md")
    return root if all(m.exists() for m in marks) else None


def _surface_message(items: list[tuple[str, str]]) -> str:
    """조건 A 의 차단 메시지. 함수로 분리한 것은 selftest 가 내용을 고정하기 위해서다."""
    width = max(len(t) for t, _ in items) + 4
    listing = "\n".join(f"  {t.ljust(width)}({why})" for t, why in items)
    return (
        "새 명령·플래그가 어떤 primary 문서에도 없다.\n\n"
        f"{listing}\n\n"
        "  명령이면: adapters/commands.py 의 표에 추가하고 `jig docs --update`, 결과를 stage 한다.\n"
        "  플래그면: README.md · docs/ko/README.md 산문에 서술을 추가하고 stage 한다.\n"
        "  사용자에게 보이는 변화면 CHANGELOG.md 의 Unreleased 에도 한 줄 남긴다.\n"
        f"  jig 표면이 아니라고 판단했으면:  {BYPASS}=1 git commit ...\n"
        "  (이 검사는 staged 문서 유무와 무관하다 — 표면은 문서에 존재해야 한다.)"
    )


def main() -> int:
    payload = json.load(sys.stdin)
    if payload.get("tool_name") != "Bash":
        return 0

    command = str((payload.get("tool_input") or {}).get("command") or "")
    has_commit, bypassed, widened, pathspec = _scan(command)
    if not has_commit or bypassed:
        return 0

    cwd = payload.get("cwd")
    if not cwd:
        return 0
    root = repo_root(cwd)
    if root is None:
        return 0  # jigkit 저장소 밖. 남의 프로젝트에서는 조용하다.
    if pathspec is not None:
        pathspec = _resolve_pathspec(pathspec, cwd, str(root))

    sys.path.insert(0, str(root / "adapters"))
    import touched  # noqa: E402

    # `-a`·pathspec 은 커밋 시점에 작업트리를 stage 한다 — 훅이 도는 지금의 index
    # 는 비어 있을 수 있다. 그 형태는 index 가 아니라 작업트리를 기준으로 판정하되,
    # pathspec 이 있으면 그 경로로 좁힌다 — 커밋에 안 실리는 무관한 변경이 게이트를
    # 채우거나(오발) 잠재우면(누락) 안 된다.
    rev = "HEAD" if widened else None
    diff = touched.code_diff(rev, paths=pathspec)

    # 조건 A — staged 문서 유무보다 먼저 본다. 엉뚱한 .md 한 줄로는 못 지나간다.
    surface = touched.new_cli_surface(worktree=widened, diff=diff, paths=pathspec)
    if surface:
        print(_surface_message(surface), file=sys.stderr)
        return 2

    # 조건 B.
    if touched.staged_docs(worktree=widened, paths=pathspec):
        return 0  # 문서를 손대긴 했다. 맞게 고쳤는지는 판정하지 않는다.

    text, has_primary = touched.report(rev, surface=surface, diff=diff)  # 재계산 방지
    if not has_primary:
        return 0

    print(
        "코드를 바꿨는데 문서 변경이 staged 되지 않았다.\n\n"
        f"{text}\n\n"
        "  고칠 문서가 있으면 고쳐서 함께 stage 한다.\n"
        "  사용자에게 보이는 변화면 CHANGELOG.md 의 Unreleased 에도 한 줄 남긴다.\n"
        f"  고칠 게 없다고 판단했으면:  {BYPASS}=1 git commit ...\n"
        "  (이 게이트는 문서가 맞는지 판정하지 않는다. 안 보고 지나가는 것만 막는다.)",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # 알림 장치가 작업을 막으면 안 된다.
